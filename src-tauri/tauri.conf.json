{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unpack",
  "version": "1.7.4",
  "identifier": "com.qeezyxz.unpack",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Unpack \u2014 ZIP \u00b7 RAR \u00b7 7Z",
        "width": 1180,
        "height": 820,
        "minWidth": 720,
        "minHeight": 520,
        "backgroundColor": "#111110"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/7za"
    ],
    "resources": {
      "../licenses/": "licenses/",
      "resources/menus/": "menus/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "7z"
        ],
        "name": "7-Zip archive",
        "description": "7-Zip archive",
        "role": "Viewer"
      },
      {
        "ext": [
          "rar"
        ],
        "name": "RAR archive",
        "description": "RAR archive",
        "role": "Viewer"
      }
    ]
  }
}
